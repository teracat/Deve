{
  // Application settings
  "AppSettings": {
    "JwtKeys": {
      "SigningSecretKey": "YouShouldChangeThisKey_MustBe32B", // You should change this key (must be 32 bytes)
      "EncryptionSecretKey": "YouShouldChangeThisKey_MustBe32B" // You should change this key (must be 32 bytes)
    }
  },

  // Connection strings
  "ConnectionStrings": {
    // <hooks:api-appsettings-connectionstrings>
    //You should set the CustomersConnectionRead (if needed by your module)
    "CustomersConnectionRead": "",
    //You should set the CustomersConnectionWrite (if needed by your module)
    "CustomersConnectionWrite": "",
    //You should set the IdentityConnectionRead (if needed by your module)
    "IdentityConnectionRead": "",
    //You should set the IdentityConnectionWrite (if needed by your module)
    "IdentityConnectionWrite": "",
    //You should set the RedisCacheConnection (if using RedisCache class as the ICache implementation)
    "RedisCacheConnection": ""
  },

  // Azure Monitor settings
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "", // If you are using Azure Monitor, set the connection string

  // OpenTelemetry endpoint (configured in Docker compose file)
  "OTEL_EXPORTER_OTLP_ENDPOINT": "",

  // Prometheus scrape endpoint
  "PROMETHEUS_SCRAPE_ENDPOINT": "/metrics",

  // Sentry
  "Sentry": {
    "Dsn": "" // You should set the Sentry Dsn (if using Sentry)
  },

  // Logging settings
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
